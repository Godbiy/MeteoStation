# Build artifacts (regenerated by avr-gcc / avr-objcopy)
build/

# Private host adapter — specific to one locked-down shared host (its live URL, a writable
# runtime dir, the self-overwrite ?edit deploy trick, a framework entry class). Useless to anyone
# else and exposes private infra, so it's kept on disk but never committed. The PUBLIC,
# self-contained server path is examples/standalone (works on any normal PHP host). See README.
server/config.php
server/config.example.php
server/deploy.sh
server/meteo.php

# Standalone example: local secrets, runtime data, copied UI
examples/standalone/config.php
examples/standalone/data/
examples/standalone/public/*.html

# Tests + probes + scratch — kept on disk, not in git
server/test_ci.py
server/_verify_*.py
firmware/probes/
__pycache__/
*.pyc

# Backups left by the server self-edit endpoint
*.bak

# Bulky vendor reference (datasheets + schematic stay; driver archives don't)
*.zip
*.rar
docs/**/IOT Product Roadmap.pdf

# Per-user / OS / IDE noise
.claude/scheduled_tasks.lock
.claude/settings.local.json
.DS_Store
Thumbs.db
.vscode/.browse.c_cpp.db*

# Atmel Studio IDE project files (regenerable, paths are stale after restructure)
*.cproj
*.componentinfo.xml
